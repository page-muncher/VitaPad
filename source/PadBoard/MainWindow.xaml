<Window x:Class="ControllerKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadBoard" Width="920" Height="680" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#111416" Foreground="#EEF1EB"
        FontFamily="Inter, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="MainText" Color="#EEF1EB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#B0BAB5" />
        <SolidColorBrush x:Key="KeyFill" Color="#272E30" />
        <SolidColorBrush x:Key="KeyOutline" Color="#3C4547" />
        <SolidColorBrush x:Key="SelectedFill" Color="#D9F6B5" />
        <SolidColorBrush x:Key="DimmedSelectedFill" Color="#809273" />
        <SolidColorBrush x:Key="SelectedText" Color="#192610" />
        <SolidColorBrush x:Key="LatchedFill" Color="#405334" />
        <SolidColorBrush x:Key="LatchedOutline" Color="#A6CD80" />
        <ScaleTransform x:Key="PressedKeyScale" ScaleX="0.87" ScaleY="0.87" />

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KeyFill}" />
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="BorderBrush" Value="{StaticResource KeyOutline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#C7D5CB" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SelectedFill}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ControllerPressed">
                                <Setter TargetName="Surface" Property="RenderTransform" Value="{StaticResource PressedKeyScale}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Margin" Value="2.6" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Viewbox StretchDirection="DownOnly" Margin="3,1,3,0">
                                <TextBlock Text="{Binding Primary}" />
                            </Viewbox>
                            <TextBlock Text="{Binding Corner}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,1,3.5,0" FontSize="{Binding CornerFontSize}" FontWeight="Normal" Opacity="0.8" />
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3.5"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Latched}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10.5,3.5,3.5,3.5"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="Surface" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="EditorRow" Height="*" MinHeight="85" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TestHeader" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Typing test" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#202627" BorderBrush="#374041" BorderThickness="1"
                    CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ControllerDot" Width="7" Height="7" Margin="0,0,8,0" Fill="#B0BAB5" />
                    <TextBlock x:Name="ControllerStatus" Text="No XInput controller" Foreground="{StaticResource SecondaryText}"
                               FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="TestEditor" Grid.Row="1" Background="#191E20" BorderBrush="#384142" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Test text" Foreground="{StaticResource SecondaryText}" FontSize="13" FontWeight="SemiBold"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBox x:Name="Editor" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource MainText}" CaretBrush="{StaticResource SelectedFill}"
                         SelectionBrush="#607D50" SelectionOpacity="0.85" FontSize="22" Padding="15,1,15,10"
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Test text" SpellCheck.IsEnabled="False" />
            </Grid>
        </Border>

        <Border x:Name="KeyboardPanel" Grid.Row="2" Background="#191E20" BorderBrush="#384142" BorderThickness="1"
                CornerRadius="12" Padding="10,9" Margin="0,12,0,0" MaxWidth="780">
            <Grid x:Name="KeyboardPages" Height="176" />
        </Border>

        <Grid x:Name="ClosedPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BaseButton}" Content="Open keyboard" Padding="14,8" Click="OpenKeyboard_Click" />
            </StackPanel>
        </Grid>
        <Border x:Name="TouchHide" Grid.Row="2" Width="32" Height="32" CornerRadius="16"
                Background="#BF111416" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                Visibility="Collapsed">
            <TextBlock Text="⌄" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
